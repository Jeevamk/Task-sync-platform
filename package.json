{
  "name": "task-sync-backend",
  "version": "0.3.0",
  "private": true,
  "description": "Task Sync Automation backend (NestJS) - keeps Trello, Google Sheets and Slack in step",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test:sign": "node scripts/test-signatures.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node scripts/test-multitenant.js",
    "test:app": "node scripts/test-app.js",
    "test": "npm run build && node scripts/test-signatures.js && node scripts/test-multitenant.js && node scripts/test-app.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@prisma/client": "6.19.3",
    "@vercel/functions": "^3.11.1",
    "google-auth-library": "11.3.1",
    "joi": "^18.3.2",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
