# ======================= Taskvane API (multi-tenant) =======================
NODE_ENV=development
PORT=3000
# Logging. LOG_LEVEL: error | warn | log | debug | verbose (default: debug locally, log in production)
# LOG_FORMAT: pretty | json (default: json in production, so Vercel can search it; pretty otherwise)
LOG_LEVEL=
LOG_FORMAT=
# Public address of THIS API (ngrok locally, https://<app>.vercel.app in production). No "/" at the end.
PUBLIC_BASE_URL=https://your-domain.ngrok-free.dev
# The coordinator web app (Step 7). Leave empty for now.
WEB_APP_URL=

# ---------- Database ----------
DATABASE_URL=postgresql://tasksync:tasksync_dev_password@localhost:5432/tasksync?schema=public
DIRECT_URL=postgresql://tasksync:tasksync_dev_password@localhost:5432/tasksync?schema=public

# ---------- Security ----------
# Encrypts every customer's Trello/Slack token in the database. 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER change it after customers have connected (their tokens could not be read any more).
TOKEN_ENCRYPTION_KEY=
# Signs login tokens. At least 32 characters (same command as above).
JWT_SECRET=
# Google Sign-In client ID for the web app (Step 7). Can stay empty while you use dev login.
GOOGLE_OAUTH_CLIENT_ID=
# Local testing only: lets you log in with POST /auth/dev-login. Must be false in production.
ALLOW_DEV_LOGIN=true

# ---------- Trello app (YOURS) ----------
# From trello.com/power-ups/admin → your Power-Up → API key. Customers connect their own accounts.
TRELLO_API_KEY=
TRELLO_APP_SECRET=

# ---------- Slack app (YOURS, with public distribution) ----------
# api.slack.com/apps → your app → Basic Information → App Credentials
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ---------- Google service account (writes every customer's sheet) ----------
# From the service account JSON key: client_email and private_key (keep the \n, keep the quotes)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Outbox / internal ----------
INTERNAL_API_KEY=
CRON_SECRET=
OUTBOX_POLL_MS=15000
# For the sheet's Apps Script (Import tab)
SHEET_SYNC_SECRET=

# ---------- Optional: also forward every event to your own n8n ----------
N8N_BASE_URL=
N8N_EVENT_WEBHOOK_URL=
N8N_EVENT_SIGNING_SECRET=
