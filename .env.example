# ======================= Taskvane API (multi-tenant) =======================
NODE_ENV=development
PORT=3000
# Logging. LOG_LEVEL: error | warn | log | debug | verbose (default: debug locally, log in production)
# LOG_FORMAT: pretty | json (default: json in production, so Vercel can search it; pretty otherwise)
LOG_LEVEL=
LOG_FORMAT=
# Public address of THIS API (ngrok locally, https://<app>.vercel.app in production). No "/" at the end.
PUBLIC_BASE_URL=https://your-domain.ngrok-free.dev
# Address of the Taskvane site (task-sync-FE), e.g. http://localhost:3001 locally, your live site in production.
# No "/" at the end. The API only accepts browser requests from it (CORS): the Sign in page needs it.
WEB_APP_URL=

# ---------- Database (MongoDB) ----------
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskvane?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/taskvane   (add ?replicaSet=rs0 if your local server is a replica set)
# Transactions need a replica set (Atlas always is one); on a standalone server they are switched off with a warning.
# Indexes are created on startup, so there is no migrate step.
MONGODB_URI=mongodb://localhost:27017/taskvane
# Optional. Database name; defaults to the name in MONGODB_URI, else "taskvane".
MONGODB_DB=

# ---------- Security ----------
# Encrypts every customer's Trello/Slack token in the database. 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER change it after customers have connected (their tokens could not be read any more).
TOKEN_ENCRYPTION_KEY=
# Signs login tokens. At least 32 characters (same command as above).
JWT_SECRET=
# Google OAuth client ID. The site's "Sign in with Google" button uses the SAME ID (NEXT_PUBLIC_GOOGLE_CLIENT_ID).
# Can stay empty while you only use dev login locally.
GOOGLE_OAUTH_CLIENT_ID=
# Same OAuth client's secret. Only for \"Connect Google\" (sheet: \"new\"). Redirect URI: PUBLIC_BASE_URL/connect/google/callback
GOOGLE_OAUTH_CLIENT_SECRET=
# Local testing only: lets you log in with POST /auth/dev-login. Must be false in production.
ALLOW_DEV_LOGIN=true

# ---------- Trello app (YOURS) ----------
# From trello.com/power-ups/admin → your Power-Up → API key. Customers connect their own accounts.
TRELLO_API_KEY=
TRELLO_APP_SECRET=

# ---------- Slack app (YOURS, with public distribution) ----------
# api.slack.com/apps → your app → Basic Information → App Credentials
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ---------- Google service account (writes every customer's sheet) ----------
# From the service account JSON key: client_email and private_key (keep the \n, keep the quotes)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Outbox / internal ----------
INTERNAL_API_KEY=
CRON_SECRET=
OUTBOX_POLL_MS=15000
# For the sheet's Apps Script (Import tab)
SHEET_SYNC_SECRET=

# ---------- Optional: also forward every event to your own n8n ----------
N8N_BASE_URL=
N8N_EVENT_WEBHOOK_URL=
N8N_EVENT_SIGNING_SECRET=
